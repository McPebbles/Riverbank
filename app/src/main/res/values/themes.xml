<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Riverbank" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="colorPrimary">@color/riverbank_primary</item>
        <item name="colorOnPrimary">@color/riverbank_on_primary</item>
        <item name="colorPrimaryContainer">@color/riverbank_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/riverbank_on_primary_container</item>
        <item name="colorSecondary">@color/riverbank_secondary</item>
        <item name="android:colorBackground">@color/riverbank_surface</item>
        <item name="colorSurface">@color/riverbank_surface</item>
        <item name="colorOnSurface">@color/riverbank_on_surface</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.Riverbank.Lock">
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>
</resources>
