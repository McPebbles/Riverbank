<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- No cleartext anywhere, and user-added CAs are not trusted, so a
         corporate or malicious root cannot silently intercept the session. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
